# 复制为 .env 后按需填写；全部留空即为免密钥模式（RSS + HN Algolia + 本地抓取 + 抽取式摘要）
# 加载方式示例：set -a && source .env && set +a

# —— 搜索（二选一；都设置时优先 Tavily，可用 SEARCH_PROVIDER=tavily|brave|hn 强制指定）——
TAVILY_API_KEY=
BRAVE_API_KEY=
SEARCH_PROVIDER=

# —— 正文抓取：设置后使用 Firecrawl，否则 requests + trafilatura ——
FIRECRAWL_API_KEY=
# 自托管 Firecrawl 时填写，默认 https://api.firecrawl.dev
FIRECRAWL_API_URL=

# —— 摘要：OpenAI 兼容接口（DeepSeek / 通义千问 / Moonshot / Ollama 等），三项都填才启用 ——
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# —— 抓取礼仪 ——
# 同一域名两次请求的最小间隔（秒）；robots.txt 声明的 Crawl-delay 更大时以其为准
DIGEST_MIN_INTERVAL=1.0
